# ============================================================
# Configuracion de entorno para JR (rama jr/onboarding)
# ============================================================
# Copiar como .env y NO CAMBIAR NADA salvo el SECRET_KEY.
#
# Esta rama tiene JR_MODE activo: DB_ENGINE=postgres esta bloqueado
# fisicamente en settings.py (ver docs/aprender/SAFETY.md). Aunque
# pongas otra cosa, Django la ignora y usa SQLite local.
# ============================================================

# === Modo ===
DEBUG=True
SECRET_KEY=django-insecure-cambiar-por-cualquier-string-de-50-caracteres-random
ALLOWED_HOSTS=localhost,127.0.0.1

# === Base de datos ===
# JR_MODE fuerza SQLite. No hay DATABASE_URL — trabajas contra db.sqlite3 local
# generado con scripts/seed_synthetic.py.
DB_ENGINE=sqlite

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === JWT ===
JWT_SECRET=
JWT_ALGORITHM=HS256

# === Throttling ===
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=5/min
THROTTLE_REGISTER=3/min
THROTTLE_WHATSAPP=30/min
