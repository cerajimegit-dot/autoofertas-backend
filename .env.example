# ============================================================
# Configuración de entorno — copiar a .env y completar.
# ============================================================
# Para DESARROLLO LOCAL alcanza con dejar DEBUG=True y no tocar más.
# Para PRODUCCIÓN cambiar TODOS los valores marcados como [PROD].

# === Modo ===
DEBUG=True                          # [PROD] DEBUG=False
SECRET_KEY=django-insecure-change-me # [PROD] string random de 50+ chars (django-admin generate)
ALLOWED_HOSTS=localhost,127.0.0.1    # [PROD] dominios reales: autoofertas.com.py,api.autoofertas.com.py

# === Base de datos ===
DB_ENGINE=sqlite                    # [PROD] postgres
DATABASE_URL=postgresql://user:password@host:6543/db  # [PROD] connection string de Supabase pooler

# === CORS — orígenes que pueden llamar a la API ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# [PROD] https://autoofertas.com.py (sin trailing slash, https obligatorio)

# === JWT ===
JWT_SECRET=                         # opcional — si vacío reutiliza SECRET_KEY
JWT_ALGORITHM=HS256

# === Throttling (rate limits) ===
# Cuántos requests por minuto se permiten por scope.
# Subir si el negocio crece; bajar si hay abuso.
THROTTLE_ANON=60/min                # cualquier request sin autenticar
THROTTLE_USER=600/min               # usuario autenticado
THROTTLE_LOGIN=5/min                # endpoint /api/users/login/ — anti brute force
THROTTLE_REGISTER=3/min             # /api/users/register/
THROTTLE_WHATSAPP=30/min            # /api/quotas/{id}/contact_whatsapp/

# === HTTPS (sólo aplica con DEBUG=False) ===
SECURE_SSL_REDIRECT=True             # [PROD] redirige http → https
SECURE_HSTS_SECONDS=3600             # [PROD] empezar en 3600 (1h); subir a 31536000 (1 año) tras 1 semana estable
SECURE_HSTS_INCLUDE_SUBDOMAINS=False # [PROD] activar SÓLO si todos los subdominios están en https
